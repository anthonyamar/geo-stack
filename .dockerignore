# See https://docs.docker.com/engine/reference/builder/#dockerignore-file

/.git/
/.gitignore
/.github
/.cursor
/.worktrees
/.devcontainer
/.playwright-cli

/.bundle
/.env*

/config/master.key
/config/credentials/*.key
/config/application.yml

/log/**
/tmp/**
!/log/.keep
!/tmp/.keep
!/tmp/pids/.keep

/storage/**
!/storage/.keep
!/tmp/storage/.keep

/node_modules/
/app/assets/builds/**
!/app/assets/builds/.keep
/public/assets

/coverage
/test
/spec
/docs

.dump*
.csv
latest.dump

/.dockerignore
/Dockerfile*
