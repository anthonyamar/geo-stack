{
  "root": true,
  "extends": [
    "airbnb-base",
    "prettier"
  ],
  "plugins": [
    "prettier"
  ],
  "env": {
    "browser": true,
    "node": true,
    "es6": true
  },
  "globals": {
    "$": true,
    "jQuery": true,
    "document": true
  },
  "parser": "@babel/eslint-parser",
  "parserOptions": {
    "requireConfigFile": false,
    "sourceType": "module",
    "ecmaVersion": "latest"
  },
  "rules": {
    "prettier/prettier": ["error"],
    "class-methods-use-this": "off",
    "max-len": [
      "error",
      {
        "code": 80,
        "ignoreUrls": true,
        "ignoreStrings": true,
        "ignoreComments": true,
        "ignoreTemplateLiterals": true,
        "ignoreRegExpLiterals": true
      }
    ],
    "import/prefer-default-export": "off",
    "no-alert": "off",
    "no-console": "off",
    "no-debugger": "off",
    "no-param-reassign": ["error", { "props": false }],
    "no-underscore-dangle": ["error", { "allowAfterThis": true }]
  },
  "settings": {
    "import/resolver": {
      "alias": {
        "map": [
          ["@", "./app/javascript"]
        ]
      },
      "node": {
        "paths": ["./vendor"]
      }
    }
  }
}
