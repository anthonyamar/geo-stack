    "@tailwindcss/typography": "^0.5.20",
    "autoprefixer": "^10.4.20",
    "daisyui": "^5.0.4",
    "esbuild": "^0.28.1"
  },
  "scripts": {
    "lint": "yarn run eslint app/javascript",
    "lint:fix": "yarn run eslint app/javascript --fix",
    "build": "esbuild app/javascript/*.* --bundle --sourcemap --format=esm --outdir=app/assets/builds --public-path=/assets --asset-names=[name]-[hash].digested --loader:.png=file --loader:.jpg=file --loader:.jpeg=file --loader:.gif=file --loader:.svg=file --loader:.woff=file --loader:.woff2=file --loader:.ttf=file --loader:.eot=file"
  },
