    "@babel/core": "^7.29.7",
    "@babel/eslint-parser": "^7.29.7",
    "eslint": "^8.2.0",
    "eslint-config-airbnb-base": "15.0.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-plugin-import": "^2.25.2",
    "eslint-plugin-prettier": "^5.2.3",
    "prettier": "^3.4.2"
  },
  "resolutions": {
    "ajv": "^6.14.0",
    "brace-expansion": "^1.1.18",
    "flatted": "^3.4.2",
    "js-yaml": "^4.3.0",
    "minimatch": "^3.1.4"
  }
