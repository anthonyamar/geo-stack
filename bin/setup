#!/usr/bin/env ruby
# frozen_string_literal: true

require "fileutils"

APP_ROOT = File.expand_path("..", __dir__)
SKIP_SERVER = ARGV.include?("--skip-server")
FROZEN_LOCKFILE = ARGV.include?("--frozen-lockfile")

def system!(*args)
  system(*args, exception: true)
end

FileUtils.chdir APP_ROOT do
  puts "== Installing dependencies =="
  system! "gem install bundler --conservative"
  system("bundle check") || system!("bundle install")

  puts "\n== Installing JavaScript dependencies =="
  yarn_install = FROZEN_LOCKFILE ? "yarn install --frozen-lockfile" : "yarn install"
  system! yarn_install

  # Figaro expects the file; CI and Coolify inject real config via ENV.
  FileUtils.touch("config/application.yml") unless File.exist?("config/application.yml")

  puts "\n== Building assets =="
  system! "bin/rails tailwindcss:build"
  system! "yarn build"

  puts "\n== Preparing database =="
  system! "bin/rails db:prepare"

  puts "\n== Removing old logs and tempfiles =="
  system! "bin/rails log:clear tmp:clear"

  unless SKIP_SERVER
    puts "\n== Restarting application server =="
    system! "bin/rails restart"
  end
end
