<header class="absolute inset-x-0 top-0 z-50 bg-base-100/90 backdrop-blur-md" data-controller="menu">
  <nav class="flex items-center justify-between p-6 lg:px-8" aria-label="<%= t('.aria_label') %>">
    <div class="flex lg:flex-1">
      <%= link_to root_path, class: "-m-1.5 p-1.5" do %>
        <span class="sr-only"><%= GeoStack::APP_NAME %></span>
        <%= image_tag("logos/logo.png", class: "h-8 w-auto", alt: t('.logo_alt')) %>
      <% end %>
    </div>
    <div class="flex lg:hidden">
      <button type="button" class="-m-2.5 inline-flex items-center justify-center rounded-md p-2.5 text-base-content" data-action="click->menu#toggleMenu">
        <span class="sr-only"><%= t('.open_menu') %></span>
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
        </svg>
      </button>
    </div>
    <div class="hidden lg:flex lg:flex-1 lg:justify-end lg:gap-x-6 lg:items-center">
      <% if user_signed_in? %>
        <%= link_to t('.my_account'), edit_user_registration_path, class: "text-sm font-semibold leading-6 text-base-content py-3" %>
      <% else %>
        <%= link_to t('.sign_in'), new_user_session_path, class: "text-sm font-semibold leading-6 text-base-content py-3" %>
        <%= link_to new_user_registration_path, class: "btn btn-primary py-3" do %>
          <%= t('.sign_up') %> <span aria-hidden="true">&rarr;</span>
        <% end %>
      <% end %>
    </div>
  </nav>
  <div class="hidden" data-menu-target="menu" role="dialog" aria-modal="true">
    <div class="fixed inset-0 z-50"></div>
    <div class="fixed inset-y-0 right-0 z-50 w-full overflow-y-auto bg-base-100 px-6 py-6 sm:max-w-sm sm:ring-1 sm:ring-base-300">
      <div class="flex items-center justify-between">
        <%= link_to root_path, class: "-m-1.5 p-1.5" do %>
          <span class="sr-only"><%= GeoStack::APP_NAME %></span>
          <%= image_tag("logos/logo.png", class: "h-8 w-auto", alt: t('.logo_alt')) %>
        <% end %>
        <button type="button" data-action="click->menu#toggleMenu" class="-m-2.5 rounded-md p-2.5 text-base-content">
          <span class="sr-only"><%= t('.close_menu') %></span>
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
      <div class="mt-6 flow-root">
        <div class="-my-6 divide-y divide-base-300">
          <div class="py-6">
            <% if user_signed_in? %>
              <%= link_to t('.my_account'), edit_user_registration_path, class: "block link -mx-3 rounded-lg px-3 py-2.5 text-base font-semibold" %>
            <% else %>
              <%= link_to t('.sign_up'), new_user_registration_path, class: "btn btn-primary block -mx-3 text-base" %>
              <%= link_to t('.sign_in'), new_user_session_path, class: "block link -mx-3 rounded-lg mt-3 px-3 py-2.5 text-base font-semibold text-center" %>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>
