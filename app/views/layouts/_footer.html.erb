<footer class="relative z-10 w-full max-w-screen-xl mx-auto p-4 md:py-8">
  <div class="sm:flex sm:items-center sm:justify-between gap-4">
    <div>
      <%= link_to root_path, class: "flex items-center mb-5 sm:mb-0" do %>
        <%= image_tag("logos/logo.png", class: "h-4 sm:h-8 mr-3", alt: t('.logo_alt')) %>
        <span class="self-center text-2xl font-semibold whitespace-nowrap tracking-wide"><%= GeoStack::APP_NAME %></span>
      <% end %>
    </div>
    <div class="flex flex-wrap items-center gap-4">
      <ul class="flex items-center text-sm font-medium text-base-content/60">
        <li>
          <%= link_to t('nav.privacy_policy'), privacy_policy_path, class: "mr-4 hover:underline md:mr-6" %>
        </li>
        <li>
          <%= link_to t('nav.terms'), terms_path, class: "mr-4 hover:underline md:mr-6" %>
        </li>
        <li>
          <%= link_to t('nav.contact'), contact_path, class: "mr-4 hover:underline md:mr-6" %>
        </li>
      </ul>
      <%= render "layouts/locale_switcher" %>
      <%= render Ui::ThemeToggleComponent.new %>
    </div>
  </div>
  <hr class="my-6 border-base-300 sm:mx-auto lg:my-8">
  <span class="block text-sm text-base-content/60 text-center">
    <%= t('.all_rights_reserved_html', year: Date.current.year, name: GeoStack::APP_NAME) %>
  </span>
</footer>
