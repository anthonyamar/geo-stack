<% if flash.any? %>
  <div data-controller="flash-message" class="relative z-[60] p-6">
    <div class='flex flex-col items-center justify-center'>
      <% flash.each do |type, message| %>
        <%= render Ui::FlashMessageComponent.new(type: type, message: message) %>
      <% end %>
    </div>
  </div>
<% end %>
