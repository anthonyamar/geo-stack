<section data-component="static-pages-contact-form">
  <div class="card bg-base-100 border border-base-300 h-full">
    <div class="card-body">
      <h2 class="card-title text-lg text-dark-blue mb-4"><%= t(".title") %></h2>

      <%= form_with model: @contact_message,
                    url: helpers.contact_path,
                    html: { class: "space-y-4" } do |f| %>
        <div class="form-control">
          <%= f.label :name, t(".name_label"), class: "label" %>
          <%= f.text_field :name,
                           autocomplete: "name",
                           placeholder: t(".name_placeholder"),
                           required: true,
                           class: "input input-bordered w-full" %>
        </div>

        <div class="form-control">
          <%= f.label :email, t(".email_label"), class: "label" %>
          <%= f.email_field :email,
                             autocomplete: "email",
                             placeholder: t(".email_placeholder"),
                             required: true,
                             class: "input input-bordered w-full" %>
        </div>

        <div class="form-control">
          <%= f.label :message, t(".message_label"), class: "label" %>
          <%= f.text_area :message,
                          rows: 5,
                          required: true,
                          class: "textarea textarea-bordered w-full resize-none min-h-[140px]",
                          placeholder: t(".message_placeholder") %>
        </div>

        <div id="contact_form_submit">
          <%= f.submit t(".submit"), class: "btn btn-primary w-full sm:w-auto" %>
        </div>
      <% end %>
    </div>
  </div>
</section>
